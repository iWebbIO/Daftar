<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The app updates itself from its own release page; Android still asks
         before installing, which is the point. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.daftar"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!--
          adjustResize: the keyboard shrinks the page instead of covering the
          field the shopkeeper is typing into.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <!--
          The share sheet. An invoice or a backup leaves the app as a
          content:// URI under this authority, which exists so another app can
          read exactly the one file the shopkeeper picked and nothing else.
          `${applicationId}.files` is `io.moreweb.daftar.files` for this app;
          SharePlugin.kt builds the same string from the app's own package name,
          so a change of application id cannot leave the two out of step.
          Kept apart from the provider above, whose authority the framework owns.
        -->
        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.files"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
